NASMFLAGS=-f elf64

KERNEL_ARCH_CFLAGS=-mcmodel=kernel -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -fno-PIC -fno-stack-protector -fno-stack-check -fno-omit-frame-pointer
KERNEL_ARCH_CPPFLAGS=-I$(ARCHDIR)/include
KERNEL_ARCH_LDFLAGS=-static -z max-page-size=0x1000
KERNEL_ARCH_LIBS=

# The boot adapter provides the entry point and the linker script.
BOOTLOADER?=limine
include $(ARCHDIR)/boot/$(BOOTLOADER)/make.config

KERNEL_ARCH_OBJS=\
$(KERNEL_BOOT_OBJS) \
$(ARCHDIR)/boot/start.o \
$(ARCHDIR)/cpu/gdt.o \
$(ARCHDIR)/cpu/gdt_flush.o \
$(ARCHDIR)/cpu/idt.o \
$(ARCHDIR)/cpu/pic.o \
$(ARCHDIR)/cpu/dump.o \
$(ARCHDIR)/entry/interrupts.o \
$(ARCHDIR)/drivers/pit.o \
$(ARCHDIR)/drivers/serial.o \
$(ARCHDIR)/mm/paging.o \
